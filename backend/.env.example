# ByteForge API environment configuration
# Copy this file to .env and adjust values.

# Comma-separated list of browser origins allowed to call this API.
# Use "*" for development only. In production, set this to your
# frontend URL, e.g. https://byteforge.vercel.app
BYTEFORGE_CORS_ORIGINS=*

# Maximum accepted upload size, in bytes. 0 disables the limit.
# 536870912 = 512 MB
BYTEFORGE_MAX_UPLOAD_BYTES=536870912

# Seconds of inactivity before an uploaded file is discarded from memory.
BYTEFORGE_SESSION_TTL_SECONDS=1800

# Port the API listens on (used by the start command in the docs).
PORT=8000
