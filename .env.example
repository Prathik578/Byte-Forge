# ByteForge frontend environment configuration
# Copy this file to .env.local (local dev) or configure in your
# hosting provider's dashboard (production).

# Base URL of the ByteForge API backend, with no trailing slash.
# Local dev:      http://localhost:8000
# Production:     https://your-backend.onrender.com
NEXT_PUBLIC_BYTEFORGE_API_URL=http://localhost:8000
